{
	"name": "header-floater",
	"version": "1.0.2",
	"description": "Pins table header rows to the top of the pane while you scroll long tables in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"table",
		"sticky-header"
	],
	"author": "Josh Glazer",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.43.15",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
